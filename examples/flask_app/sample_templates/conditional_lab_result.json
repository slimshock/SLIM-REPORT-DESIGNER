{
  "version": "1.0",
  "metadata": {
    "title": "Conditional Laboratory Result",
    "description": "Laboratory result template demonstrating object conditional formatting.",
    "author": "Slim Report Designer",
    "tags": ["demo", "lab", "conditions"],
    "custom": {
      "id": "conditional_lab_result",
      "provider": "conditional_lab_result"
    }
  },
  "page": {
    "id": "page_1",
    "width": 595,
    "height": 842,
    "unit": "px",
    "orientation": "portrait",
    "margin_top": 0.5,
    "margin_right": 0.5,
    "margin_bottom": 0.5,
    "margin_left": 0.5,
    "background_color": "#ffffff",
    "transparent": false
  },
  "objects": [
    {
      "id": "title",
      "type": "text",
      "x": 40,
      "y": 30,
      "width": 360,
      "height": 28,
      "text": "CONDITIONAL LAB RESULT",
      "style": {"font_size": 20, "bold": true},
      "band": "page_header",
      "band_id": "page_header",
      "properties": {
        "text": "CONDITIONAL LAB RESULT",
        "band": "page_header",
        "band_id": "page_header",
        "style": {"font_size": 20, "bold": true}
      }
    },
    {
      "id": "patient_name",
      "type": "field",
      "x": 40,
      "y": 70,
      "width": 250,
      "height": 18,
      "binding": "patient.name",
      "style": {"font_size": 11, "bold": true},
      "band": "page_header",
      "band_id": "page_header",
      "properties": {
        "binding": "patient.name",
        "band": "page_header",
        "band_id": "page_header",
        "style": {"font_size": 11, "bold": true}
      }
    },
    {
      "id": "order_id",
      "type": "field",
      "x": 380,
      "y": 70,
      "width": 160,
      "height": 18,
      "binding": "order.id",
      "style": {"font_size": 11, "align": "right"},
      "band": "page_header",
      "band_id": "page_header",
      "properties": {
        "binding": "order.id",
        "band": "page_header",
        "band_id": "page_header",
        "style": {"font_size": 11, "align": "right"}
      }
    },
    {
      "id": "group_name",
      "type": "field",
      "x": 40,
      "y": 106,
      "width": 500,
      "height": 20,
      "binding": "group.value",
      "style": {"font_size": 12, "bold": true, "background_color": "#f3f4f6"},
      "conditions": [
        {
          "id": "large_group",
          "enabled": true,
          "condition": "group.count > 3",
          "style": {"background_color": "#fef3c7", "bold": true}
        }
      ],
      "band": "group_header_results",
      "band_id": "group_header_results",
      "properties": {
        "binding": "group.value",
        "conditions": [
          {
            "id": "large_group",
            "enabled": true,
            "condition": "group.count > 3",
            "style": {"background_color": "#fef3c7", "bold": true}
          }
        ],
        "band": "group_header_results",
        "band_id": "group_header_results",
        "style": {"font_size": 12, "bold": true, "background_color": "#f3f4f6"}
      }
    },
    {
      "id": "test_header",
      "type": "text",
      "x": 40,
      "y": 138,
      "width": 140,
      "height": 18,
      "text": "TEST",
      "style": {"font_size": 10, "bold": true},
      "band": "detail",
      "band_id": "detail",
      "properties": {"text": "TEST", "band": "detail", "band_id": "detail", "style": {"font_size": 10, "bold": true}}
    },
    {
      "id": "result_header",
      "type": "text",
      "x": 200,
      "y": 138,
      "width": 120,
      "height": 18,
      "text": "RESULT",
      "style": {"font_size": 10, "bold": true},
      "band": "detail",
      "band_id": "detail",
      "properties": {"text": "RESULT", "band": "detail", "band_id": "detail", "style": {"font_size": 10, "bold": true}}
    },
    {
      "id": "flag_header",
      "type": "text",
      "x": 350,
      "y": 138,
      "width": 80,
      "height": 18,
      "text": "FLAG",
      "style": {"font_size": 10, "bold": true},
      "band": "detail",
      "band_id": "detail",
      "properties": {"text": "FLAG", "band": "detail", "band_id": "detail", "style": {"font_size": 10, "bold": true}}
    },
    {
      "id": "row_test",
      "type": "field",
      "x": 40,
      "y": 162,
      "width": 140,
      "height": 18,
      "binding": "test",
      "style": {"font_size": 10},
      "band": "detail",
      "band_id": "detail",
      "properties": {"binding": "test", "band": "detail", "band_id": "detail", "style": {"font_size": 10}}
    },
    {
      "id": "row_result",
      "type": "field",
      "x": 200,
      "y": 162,
      "width": 120,
      "height": 18,
      "binding": "",
      "formula": "concat(result, ' ', unit)",
      "formula_mode": true,
      "style": {"font_size": 10, "color": "#111827"},
      "conditions": [
        {
          "id": "high_flag",
          "enabled": true,
          "condition": "flag == 'H'",
          "style": {"color": "#dc2626", "bold": true, "background_color": "#fee2e2"}
        },
        {
          "id": "low_flag",
          "enabled": true,
          "condition": "flag == 'L'",
          "style": {"color": "#2563eb", "bold": true, "background_color": "#dbeafe"}
        },
        {
          "id": "hide_empty_result",
          "enabled": true,
          "condition": "default(result, '') == ''",
          "action": "hide"
        }
      ],
      "band": "detail",
      "band_id": "detail",
      "properties": {
        "binding": "",
        "formula": "concat(result, ' ', unit)",
        "formula_mode": true,
        "conditions": [
          {
            "id": "high_flag",
            "enabled": true,
            "condition": "flag == 'H'",
            "style": {"color": "#dc2626", "bold": true, "background_color": "#fee2e2"}
          },
          {
            "id": "low_flag",
            "enabled": true,
            "condition": "flag == 'L'",
            "style": {"color": "#2563eb", "bold": true, "background_color": "#dbeafe"}
          },
          {
            "id": "hide_empty_result",
            "enabled": true,
            "condition": "default(result, '') == ''",
            "action": "hide"
          }
        ],
        "band": "detail",
        "band_id": "detail",
        "style": {"font_size": 10, "color": "#111827"}
      }
    },
    {
      "id": "row_flag",
      "type": "field",
      "x": 350,
      "y": 162,
      "width": 80,
      "height": 18,
      "binding": "flag",
      "style": {"font_size": 10},
      "band": "detail",
      "band_id": "detail",
      "properties": {"binding": "flag", "band": "detail", "band_id": "detail", "style": {"font_size": 10}}
    },
    {
      "id": "footer",
      "type": "field",
      "x": 390,
      "y": 802,
      "width": 140,
      "height": 16,
      "binding": "",
      "formula": "concat('Page ', page.number, ' of ', page.total_pages)",
      "formula_mode": true,
      "style": {"font_size": 10, "align": "right"},
      "band": "page_footer",
      "band_id": "page_footer",
      "properties": {
        "binding": "",
        "formula": "concat('Page ', page.number, ' of ', page.total_pages)",
        "formula_mode": true,
        "band": "page_footer",
        "band_id": "page_footer",
        "style": {"font_size": 10, "align": "right"}
      }
    }
  ],
  "bands": [
    {"id": "page_header", "type": "page_header", "name": "Page Header", "y": 0, "height": 100, "background_color": "transparent", "visible": true, "locked": false, "properties": {}},
    {
      "id": "group_header_results",
      "type": "group_header",
      "name": "Group Header",
      "y": 100,
      "height": 32,
      "background_color": "#f3f4f6",
      "visible": true,
      "locked": false,
      "group": {"id": "results_section", "data_path": "results", "field": "section", "sort": "none"},
      "properties": {}
    },
    {
      "id": "detail",
      "type": "detail",
      "name": "Detail",
      "y": 132,
      "height": 648,
      "background_color": "transparent",
      "visible": true,
      "locked": false,
      "repeat": {"enabled": true, "data_path": "results", "row_height": 24, "preview_rows": 12, "empty_message": "No results"},
      "properties": {}
    },
    {"id": "page_footer", "type": "page_footer", "name": "Page Footer", "y": 780, "height": 62, "background_color": "transparent", "visible": true, "locked": false, "properties": {}}
  ],
  "assets": [],
  "data": {
    "sample": {
      "laboratory": {"name": "Cerebro Diagnostic System", "address": "Cagayan de Oro City, Philippines"},
      "patient": {"name": "JUAN DELA CRUZ", "patient_no": "P-00001234", "age": "34", "sex": "Male", "dob": "1992-04-18"},
      "order": {"id": "ORDER-1001", "date": "2026-07-06", "physician": "Dr. Maria Santos"},
      "results": [
        {"section": "HEMATOLOGY", "test": "WBC", "result": "7.10", "value": "7.10", "unit": "10^9/L", "reference": "4.00 - 10.00", "flag": "N", "numeric_value": 7.1},
        {"section": "HEMATOLOGY", "test": "HGB", "result": "11.20", "value": "11.20", "unit": "g/dL", "reference": "13.00 - 17.00", "flag": "L", "numeric_value": 11.2},
        {"section": "HEMATOLOGY", "test": "PLT", "result": "265", "value": "265", "unit": "10^9/L", "reference": "150 - 400", "flag": "N", "numeric_value": 265},
        {"section": "HEMATOLOGY", "test": "RBC", "result": "5.02", "value": "5.02", "unit": "10^12/L", "reference": "4.50 - 5.90", "flag": "N", "numeric_value": 5.02},
        {"section": "CHEMISTRY", "test": "Glucose", "result": "126", "value": "126", "unit": "mg/dL", "reference": "70 - 99", "flag": "H", "numeric_value": 126},
        {"section": "CHEMISTRY", "test": "Creatinine", "result": "0.92", "value": "0.92", "unit": "mg/dL", "reference": "0.70 - 1.30", "flag": "N", "numeric_value": 0.92},
        {"section": "CHEMISTRY", "test": "Manual Review", "result": "", "value": "", "unit": "", "reference": "", "flag": "", "numeric_value": 0}
      ]
    },
    "fields": [
      {"path": "patient.name", "label": "Patient Name", "type": "string"},
      {"path": "order.id", "label": "Order ID", "type": "string"},
      {"path": "results[]", "label": "Results", "type": "array"},
      {"path": "results[].section", "label": "Section", "type": "string"},
      {"path": "results[].test", "label": "Test", "type": "string"},
      {"path": "results[].result", "label": "Result", "type": "string"},
      {"path": "results[].unit", "label": "Unit", "type": "string"},
      {"path": "results[].flag", "label": "Flag", "type": "string"},
      {"path": "results[].numeric_value", "label": "Numeric Value", "type": "number"}
    ]
  }
}
